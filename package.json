{
  "name": "ksebe-ecosystem",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "K Sebe Yoga Studio - InsideFlow Ecosystem (WEB + APP + Shared)",
  "workspaces": [
    "shared",
    "k-sebe-yoga-studioWEB",
    "k-sebe-yoga-studio-APPp"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:app",
    "dev:web": "npm run dev --workspace=k-sebe-yoga-studioWEB",
    "dev:app": "npm run dev --workspace=k-sebe-yoga-studio-APPp",
    "preview": "npm-run-all --parallel preview:web preview:app",
    "preview:web": "npm run preview --workspace=k-sebe-yoga-studioWEB",
    "preview:app": "npm run preview --workspace=k-sebe-yoga-studio-APPp",
    "build:web": "npm run build --workspace=k-sebe-yoga-studioWEB",
    "build:app": "npm run build --workspace=k-sebe-yoga-studio-APPp",
    "build:all": "npm run build:web && npm run build:app",
    "check:migrations": "node scripts/check-migration-integrity.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --project shared/tsconfig.json --noEmit && tsc --project k-sebe-yoga-studioWEB/tsconfig.json --noEmit && tsc --project k-sebe-yoga-studio-APPp/tsconfig.json --noEmit",
    "clean": "rm -rf node_modules shared/node_modules k-sebe-yoga-studioWEB/node_modules k-sebe-yoga-studio-APPp/node_modules",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:web": "npm run test --workspace=k-sebe-yoga-studioWEB --if-present",
    "test:app": "npm run test --workspace=k-sebe-yoga-studio-APPp --if-present",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "optimize:images": "node scripts/optimize-images.mjs",
    "optimize:images:force": "node scripts/optimize-images.mjs --force",
    "create-admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.0.18",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.4",
    "msw": "^2.14.6",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "supabase": "^2.98.2",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
