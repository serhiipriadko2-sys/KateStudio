{
  "name": "ksebe-ecosystem",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "K Sebe Yoga Studio - InsideFlow Ecosystem (WEB + APP + Shared)",
  "workspaces": [
    "shared",
    "k-sebe-yoga-studioWEB",
    "k-sebe-yoga-studio-APPp"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=k-sebe-yoga-studioWEB",
    "dev:app": "npm run dev --workspace=k-sebe-yoga-studio-APPp",
    "build:web": "npm run build --workspace=k-sebe-yoga-studioWEB",
    "build:app": "npm run build --workspace=k-sebe-yoga-studio-APPp",
    "build:all": "npm run build:web && npm run build:app",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --project shared/tsconfig.json --noEmit && tsc --project k-sebe-yoga-studioWEB/tsconfig.json --noEmit && tsc --project k-sebe-yoga-studio-APPp/tsconfig.json --noEmit",
    "clean": "rm -rf node_modules shared/node_modules k-sebe-yoga-studioWEB/node_modules k-sebe-yoga-studio-APPp/node_modules",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:web": "npm run test --workspace=k-sebe-yoga-studioWEB --if-present",
    "test:app": "npm run test --workspace=k-sebe-yoga-studio-APPp --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "dotenv": "^17.3.1",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.3.2",
    "msw": "^2.12.10",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
