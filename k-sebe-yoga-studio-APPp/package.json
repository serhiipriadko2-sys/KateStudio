{
  "name": "k-sebe-yoga-studio-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:mobile": "sh -c 'npm run build && (npm exec cap -- sync android || (npm exec cap -- add android && npm exec cap -- sync android))'",
    "build:mobile:ios": "sh -c 'npm run build && (npm exec cap -- sync ios || (npm exec cap -- add ios && npm exec cap -- sync ios))'",
    "cap:sync": "npm exec cap -- sync",
    "cap:sync:android": "npm exec cap -- sync android",
    "cap:sync:ios": "npm exec cap -- sync ios",
    "cap:add:android": "npm exec cap -- add android",
    "cap:add:ios": "npm exec cap -- add ios",
    "cap:open:android": "npm exec cap -- open android",
    "cap:open:ios": "npm exec cap -- open ios"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.0",
    "@capacitor/haptics": "^7.0.4",
    "@capacitor/keyboard": "^7.0.5",
    "@capacitor/network": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.5",
    "@google/genai": "^1.33.0",
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.90.21",
    "dompurify": "^3.3.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@sentry/react": "^10.43.0",
    "firebase": "^11.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.3",
    "vite": "^7.3.1"
  }
}
