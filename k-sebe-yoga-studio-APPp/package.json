{
  "name": "k-sebe-yoga-studio-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:mobile": "node ./scripts/capacitor-platform.mjs android",
    "build:mobile:ios": "node ./scripts/capacitor-platform.mjs ios",
    "cap:sync": "npm exec cap -- sync",
    "cap:sync:android": "npm exec cap -- sync android",
    "cap:sync:ios": "npm exec cap -- sync ios",
    "cap:add:android": "npm exec cap -- add android",
    "cap:add:ios": "npm exec cap -- add ios",
    "cap:open:android": "npm exec cap -- open android",
    "cap:open:ios": "npm exec cap -- open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "8.3.3",
