# K Sebe Yoga Studio WEB - Environment Variables
# Copy this file to .env and fill in your values
#
# IMPORTANT: All client-side variables MUST start with VITE_ prefix
# to be exposed to the Vite build process.

# ============================================
# SUPABASE (Required)
# ============================================
# Get these from your Supabase project dashboard:
# https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# GOOGLE AI / GEMINI (Server-side only)
# ============================================
# IMPORTANT: Do NOT use VITE_GEMINI_API_KEY — it leaks into the client bundle.
# AI calls go through the Supabase Edge Function proxy (gemini-proxy).
# Set the key server-side: supabase secrets set GEMINI_API_KEY=your-key

# ============================================
# DEPLOYMENT
# ============================================
# Base path for GitHub Pages deployment (e.g. /k-sebe-yoga-studio/)
# Leave as / for custom domain
VITE_BASE_PATH=/

# ============================================
# APPLICATION
# ============================================
VITE_APP_NAME="K Sebe Yoga Studio"
VITE_APP_URL=https://ksebe-studio.ru

# ============================================
# OPTIONAL: Analytics
# ============================================
# VITE_MIXPANEL_TOKEN=your-mixpanel-token
# VITE_GA_ID=G-XXXXXXXXXX

# ============================================
# OPTIONAL: Payment Integration
# ============================================
# VITE_STRIPE_PUBLIC_KEY=pk_test_xxx
# VITE_YOOKASSA_SHOP_ID=your-shop-id

# ============================================
# DEVELOPMENT
# ============================================
VITE_DEV_MODE=true
# VITE_API_MOCK=true
