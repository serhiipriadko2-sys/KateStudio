# K Sebe Yoga Studio - Environment Variables
# Copy this file to .env and fill in your values
#
# IMPORTANT: All client-side variables MUST start with VITE_ prefix
# to be exposed to the Vite build process.

# ============================================
# SUPABASE (Required)
# ============================================
# Get these from your Supabase project dashboard:
# https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# GOOGLE AI / GEMINI (Server-side only)
# ============================================
# IMPORTANT: Do NOT use VITE_GEMINI_API_KEY — it leaks into the client bundle.
# Store the Gemini key server-side via Supabase Edge Function secrets:
#   supabase secrets set GEMINI_API_KEY=your-gemini-api-key

# ============================================
# APPLICATION
# ============================================
VITE_APP_NAME="K Sebe Yoga Studio"
VITE_APP_URL=https://ksebe-studio.ru

# ============================================
# OPTIONAL: Analytics
# ============================================
# VITE_MIXPANEL_TOKEN=your-mixpanel-token
# VITE_GA_ID=G-XXXXXXXXXX

# ============================================
# OPTIONAL: Payment Integration
# ============================================
# VITE_STRIPE_PUBLIC_KEY=pk_test_xxx
# VITE_YOOKASSA_SHOP_ID=your-shop-id

# ============================================
# DEVELOPMENT
# ============================================
VITE_DEV_MODE=true
# VITE_API_MOCK=true

# ============================================
# GITHUB ACTIONS (CI/CD) — NOT stored here
# ============================================
# These must be set as GitHub Secrets:
#   Repository → Settings → Secrets and variables → Actions
#
# Required secrets:
#   VITE_SUPABASE_URL      — same as above
#   VITE_SUPABASE_ANON_KEY — same as above
#
# Without them, deploy-pages.yml and ci.yml builds work
# but the deployed site won't connect to Supabase.
